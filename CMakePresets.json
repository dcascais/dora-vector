{
  "version": 12,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "binaryDir": "${sourceDir}/build-release"
    },
    {
      "name": "benchmarks",
      "inherits": "release",
      "description": "Release benchmark build; select its clangd database with dora_clangd_select.",
      "binaryDir": "${sourceDir}/build-benchmarks",
      "cacheVariables": {
        "DORA_BUILD_BENCHMARKS": true
      }
    },
    {
      "name": "llvm-debug",
      "inherits": "default",
      "description": "Clang Debug build; select the actual compiler externally through CC, CMAKE_C_COMPILER, or a toolchain file.",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "DORA_EXPECTED_C_COMPILER_ID": "Clang"
      }
    },
    {
      "name": "llvm-release",
      "inherits": "release",
      "description": "Clang Release build; select the actual compiler externally through CC, CMAKE_C_COMPILER, or a toolchain file.",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "DORA_EXPECTED_C_COMPILER_ID": "Clang"
      }
    },
    {
      "name": "appleclang-debug",
      "inherits": "default",
      "description": "AppleClang Debug build; select the actual compiler externally through CC, CMAKE_C_COMPILER, or a toolchain file.",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "DORA_EXPECTED_C_COMPILER_ID": "AppleClang"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "appleclang-release",
      "inherits": "release",
      "description": "AppleClang Release build; select the actual compiler externally through CC, CMAKE_C_COMPILER, or a toolchain file.",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "DORA_EXPECTED_C_COMPILER_ID": "AppleClang"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "gcc-debug",
      "inherits": "default",
      "description": "GNU Debug build; select the actual compiler externally through CC, CMAKE_C_COMPILER, or a toolchain file.",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "DORA_EXPECTED_C_COMPILER_ID": "GNU"
      }
    },
    {
      "name": "gcc-release",
      "inherits": "release",
      "description": "GNU Release build; select the actual compiler externally through CC, CMAKE_C_COMPILER, or a toolchain file.",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "DORA_EXPECTED_C_COMPILER_ID": "GNU"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "targets": [
        "all",
        "all_verify_header_sets"
      ]
    },
    {
      "name": "release",
      "configurePreset": "release",
      "targets": [
        "all",
        "all_verify_header_sets"
      ]
    },
    {
      "name": "benchmarks",
      "configurePreset": "benchmarks",
      "targets": [
        "all",
        "all_verify_header_sets"
      ]
    },
    {
      "name": "llvm-debug",
      "inherits": "default",
      "configurePreset": "llvm-debug"
    },
    {
      "name": "llvm-release",
      "inherits": "default",
      "configurePreset": "llvm-release"
    },
    {
      "name": "appleclang-debug",
      "inherits": "default",
      "configurePreset": "appleclang-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "appleclang-release",
      "inherits": "default",
      "configurePreset": "appleclang-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "gcc-debug",
      "inherits": "default",
      "configurePreset": "gcc-debug"
    },
    {
      "name": "gcc-release",
      "inherits": "default",
      "configurePreset": "gcc-release"
    }
  ],
  "workflowPresets": [
    {
      "name": "default",
      "steps": [
        {
          "type": "configure",
          "name": "default"
        },
        {
          "type": "build",
          "name": "default"
        }
      ]
    },
    {
      "name": "release",
      "steps": [
        {
          "type": "configure",
          "name": "release"
        },
        {
          "type": "build",
          "name": "release"
        }
      ]
    },
    {
      "name": "benchmarks",
      "steps": [
        {
          "type": "configure",
          "name": "benchmarks"
        },
        {
          "type": "build",
          "name": "benchmarks"
        },
        {
          "type": "test",
          "name": "benchmarks-check"
        },
        {
          "type": "test",
          "name": "benchmarks"
        }
      ]
    },
    {
      "name": "llvm-debug",
      "steps": [
        {
          "type": "configure",
          "name": "llvm-debug"
        },
        {
          "type": "build",
          "name": "llvm-debug"
        }
      ]
    },
    {
      "name": "llvm-release",
      "steps": [
        {
          "type": "configure",
          "name": "llvm-release"
        },
        {
          "type": "build",
          "name": "llvm-release"
        }
      ]
    },
    {
      "name": "appleclang-debug",
      "steps": [
        {
          "type": "configure",
          "name": "appleclang-debug"
        },
        {
          "type": "build",
          "name": "appleclang-debug"
        }
      ]
    },
    {
      "name": "appleclang-release",
      "steps": [
        {
          "type": "configure",
          "name": "appleclang-release"
        },
        {
          "type": "build",
          "name": "appleclang-release"
        }
      ]
    },
    {
      "name": "gcc-debug",
      "steps": [
        {
          "type": "configure",
          "name": "gcc-debug"
        },
        {
          "type": "build",
          "name": "gcc-debug"
        }
      ]
    },
    {
      "name": "gcc-release",
      "steps": [
        {
          "type": "configure",
          "name": "gcc-release"
        },
        {
          "type": "build",
          "name": "gcc-release"
        }
      ]
    }
  ],
  "testPresets": [
    {
      "name": "benchmarks-check",
      "configurePreset": "benchmarks",
      "filter": {
        "include": {
          "label": "^benchmark$"
        },
        "exclude": {
          "label": "^performance$"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "benchmarks",
      "configurePreset": "benchmarks",
      "filter": {
        "include": {
          "label": "^performance$"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
